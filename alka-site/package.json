{
	"name": "alka-site",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:products",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:products": "node scripts/check-products.mjs",
		"storybook": "storybook dev -p 6006",
		"build:storybook": "storybook build",
		"deploy": "npm run build && wrangler deploy",
		"cf:dev": "npm run build && wrangler dev"
	},
	"dependencies": {
		"motion": "^13.0.0"
	},
	"devDependencies": {
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/sveltekit": "^10.5.6",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.1.2",
		"storybook": "^10.5.6",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.0",
		"wrangler": "^4.119.0"
	}
}
