---
import type { Dict } from '../i18n/content';
interface Props { t: Dict }
const { t } = Astro.props;
---

<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <div class="foot-brand">
          <span class="drop">💧</span>
          <span class="name">Wet Water</span>
        </div>
        <p class="statement">{t.footer.statement}</p>
      </div>
      <div>
        <div class="news-label">{t.footer.newsletter}</div>
        <form class="news-form" id="news-form">
          <input type="email" required placeholder={t.footer.placeholder} />
          <button type="submit">{t.footer.subscribe}</button>
        </form>
        <div class="news-thanks" id="news-thanks" hidden>{t.footer.newsletterThanks}</div>
      </div>
    </div>
    <div class="foot-rule"></div>
    <div class="foot-bottom">
      <p class="legal">{t.footer.legal}</p>
      <a href="#top" class="back-top">{t.footer.backToTop}</a>
    </div>
  </div>
</footer>
