---
import type { Dict } from '../i18n/content';
interface Props { t: Dict }
const { t } = Astro.props;
---

<section class="features" id="features">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Features</span>
      <h2>{t.features.title}</h2>
    </div>
    <div class="grid-auto feature-grid" data-reveal>
      {t.features.items.map((feat) => (
        <div class="feature-card">
          <div class="icon">{feat.icon}</div>
          <div>
            <div class="title">{feat.title}</div>
            {feat.desc && <div class="desc">{feat.desc}</div>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
